{
  "name": "zutto-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://zuttoapp.github.io/zutto-webapp",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,json,md}\"",
    "check": "pnpm run lint && pnpm run format:check && pnpm run check-types && pnpm run build",
    "test": "npm run lint && npm run format:check && npm run check-types && npm run build",
    "check-types": "tsc --noEmit",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^12.15.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.4.2"
  },
  "overrides": {
    "glob@>=10.2.0 <10.5.0": ">=10.5.0",
    "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
    "minimatch@<3.1.3": ">=3.1.3",
    "minimatch@<3.1.4": ">=3.1.4",
    "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
    "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
    "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
    "ajv@<6.14.0": ">=6.14.0",
    "flatted@<3.4.0": ">=3.4.0",
    "flatted@<=3.4.1": ">=3.4.2",
    "picomatch@<2.3.2": ">=2.3.2",
    "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
    "micromatch": {
      "picomatch": "4.0.4"
    },
    "anymatch": {
      "picomatch": "4.0.4"
    },
    "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "1.1.13"
    }
  }
}
